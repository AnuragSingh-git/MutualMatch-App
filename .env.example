# Frontend API origin. Leave blank to use the Vite proxy to localhost:4000.
VITE_API_URL=

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATA_FILE=../../data/state.json
# Set MONGODB_URI to use MongoDB instead of the local JSON file.
# Example local URI: mongodb://127.0.0.1:27017
# Example Atlas URI: mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_URI=
MONGODB_DB=coy_discover
MONGODB_COLLECTION=app_state
AUTH_SECRET=replace-with-a-long-random-secret-before-deploying
